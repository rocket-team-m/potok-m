[Unit]
Description=Potok-M AI assist inference (UART, 50 Hz)
Documentation=file:/opt/potok-ai/README.md
After=multi-user.target

[Service]
Type=simple
User=potok
Group=dialout
WorkingDirectory=/opt/potok-ai
ExecStart=/opt/potok-ai/infer --model /opt/potok-ai/model.bin --device /dev/ttyS0 --baud 921600
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
